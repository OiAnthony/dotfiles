typeset -U path PATH fpath FPATH

# Static Homebrew environment. Avoid spawning `brew shellenv` on every login.
if [[ -d /opt/homebrew ]]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
  fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
  export MANPATH="/opt/homebrew/share/man:${MANPATH:-}"
  export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
fi

path+=("$HOME/Library/Application Support/JetBrains/Toolbox/scripts")

# macOS /etc/zprofile runs path_helper after ~/.zshenv and moves system paths
# ahead of user paths. Restore mise precedence without spawning mise at login.
path=("$HOME/.local/share/mise/shims" "$HOME/.local/bin" $path)
export PATH FPATH
